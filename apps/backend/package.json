{
    "name": "@portfolio/backend",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "nest start --watch",
        "build": "nest build",
        "start": "node dist/main.js",
        "lint": "eslint \"{src,test}/**/*.ts\"",
        "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
        "test": "jest --config jest.config.cjs --runInBand",
        "test:coverage": "jest --config jest.config.cjs --runInBand --coverage",
        "test:watch": "jest --config jest.config.cjs --watch",
        "test:e2e": "jest --config test/jest-e2e.config.cjs --runInBand",
        "db:migrate": "tsx src/database/run-migrations.ts",
        "db:seed": "tsx src/database/seed-admin.ts"
    },
    "dependencies": {
        "@nestjs/common": "11.1.26",
        "@nestjs/core": "11.1.26",
        "@nestjs/jwt": "11.0.2",
        "@nestjs/mapped-types": "2.1.0",
        "@nestjs/platform-express": "11.1.26",
        "bcrypt": "6.0.0",
        "class-transformer": "0.5.1",
        "class-validator": "0.14.2",
        "dotenv": "17.2.3",
        "pg": "8.21.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2"
    },
    "devDependencies": {
        "@nestjs/cli": "11.0.23",
        "@nestjs/testing": "11.1.26",
        "@types/bcrypt": "6.0.0",
        "@types/express": "5.0.6",
        "@types/jest": "29.5.14",
        "@types/node": "25.0.3",
        "@types/pg": "8.16.0",
        "@types/supertest": "6.0.3",
        "jest": "29.7.0",
        "supertest": "7.2.2",
        "ts-jest": "29.4.6",
        "tsx": "4.22.4",
        "typescript": "5.9.3"
    }
}
